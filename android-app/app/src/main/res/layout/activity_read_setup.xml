<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/readSetupRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/readSetupTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/read_setup_room_title"
        android:textColor="@color/text_primary"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/readSetupHelp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/read_setup_room_help"
        android:textColor="@color/text_secondary"
        android:textSize="16sp" />

    <EditText
        android:id="@+id/roomExample"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_field"
        android:gravity="top|start"
        android:hint="@string/room_example_hint"
        android:inputType="textMultiLine"
        android:minHeight="96dp"
        android:minLines="3"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/hint"
        android:textSize="16sp" />

    <EditText
        android:id="@+id/ventExample"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_field"
        android:gravity="top|start"
        android:hint="@string/vent_example_hint"
        android:inputType="textMultiLine"
        android:minHeight="96dp"
        android:minLines="2"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/hint"
        android:textSize="16sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/readSetupError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/error"
        android:textSize="16sp" />

    <Button
        android:id="@+id/readSetupNext"
        style="@style/PrimaryButton"
        android:layout_marginTop="12dp"
        android:text="@string/read_setup_next" />
</LinearLayout>
