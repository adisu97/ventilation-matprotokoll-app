<?xml version="1.0" encoding="utf-8"?>
<!-- Single layout for portrait, landscape and tablets. Starta stays pinned above the scroller. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/screenRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_bg"
    android:gravity="top"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/screen_padding"
        android:layout_marginTop="@dimen/screen_padding"
        android:layout_marginRight="@dimen/screen_padding"
        android:background="@drawable/bg_card"
        android:gravity="top"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding">

        <TextView
            android:id="@+id/versionLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="8dp"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <Button
            android:id="@+id/start"
            style="@style/PrimaryButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:enabled="false"
            android:text="@string/start" />

        <TextView
            android:id="@+id/formError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/error"
            android:textSize="@dimen/body_text" />

        <ProgressBar
            android:id="@+id/progress"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:max="100"
            android:minHeight="16dp"
            android:progress="0"
            android:progressBackgroundTint="@color/progress_track"
            android:progressTint="@color/progress_fill" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_horizontal"
            android:text="@string/status_idle"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/body_text" />

        <TextView
            android:id="@+id/eta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center_horizontal"
            android:text="@string/eta_idle"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/body_text" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/formScroller"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:orientation="vertical"
            android:padding="@dimen/screen_padding">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="@dimen/screen_padding">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:labelFor="@id/excelName"
                    android:text="@string/excel_label"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/body_text"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/excelName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_field"
                    android:hint="@string/excel_hint"
                    android:inputType="text"
                    android:minHeight="@dimen/button_height"
                    android:singleLine="true"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/hint"
                    android:textSize="@dimen/body_text" />

                <Button
                    android:id="@+id/pickPdfs"
                    style="@style/SecondaryButton"
                    android:layout_marginTop="@dimen/gap"
                    android:text="@string/pick_pdfs" />

                <Button
                    android:id="@+id/takePhoto"
                    style="@style/SecondaryButton"
                    android:layout_marginTop="@dimen/gap"
                    android:text="@string/take_photo" />

                <Button
                    android:id="@+id/ventNames"
                    style="@style/SecondaryButton"
                    android:layout_marginTop="@dimen/gap"
                    android:text="@string/vent_names" />

                <Button
                    android:id="@+id/roomFormats"
                    style="@style/SecondaryButton"
                    android:layout_marginTop="@dimen/gap"
                    android:text="@string/room_formats" />

                <LinearLayout
                    android:id="@+id/appendRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gap"
                    android:gravity="center_vertical"
                    android:minHeight="64dp"
                    android:orientation="horizontal">

                    <Switch
                        android:id="@+id/appendExisting"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:minWidth="56dp" />

                    <TextView
                        android:id="@+id/appendLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="@string/append_existing"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/body_text" />
                </LinearLayout>

                <TextView
                    android:id="@+id/workbookMode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/new_workbook_hint"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/body_text" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap"
                android:text="@string/list_heading"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/body_text"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/emptyList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/empty_list"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/body_text" />

            <LinearLayout
                android:id="@+id/fileList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="vertical" />

            <Button
                android:id="@+id/download"
                style="@style/SecondaryButton"
                android:layout_marginTop="@dimen/gap"
                android:enabled="false"
                android:text="@string/download" />

            <Button
                android:id="@+id/showOcr"
                style="@style/SecondaryButton"
                android:layout_marginTop="@dimen/gap"
                android:text="@string/show_ocr" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
