<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/roomFormatsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_bg"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/room_formats_title"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/room_formats_help"
                android:textColor="@color/text_secondary"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/roomExample"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_field"
                android:hint="@string/room_example_hint"
                android:inputType="text"
                android:minHeight="48dp"
                android:singleLine="true"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/hint"
                android:textSize="16sp" />

            <Button
                android:id="@+id/addRoomExample"
                style="@style/SecondaryButton"
                android:layout_marginTop="8dp"
                android:text="@string/add_vent" />

            <TextView
                android:id="@+id/roomFormatError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/error"
                android:textSize="16sp" />

            <LinearLayout
                android:id="@+id/roomExampleList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/room_format_test"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/roomTrial"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_field"
                android:hint="@string/room_trial_hint"
                android:inputType="text"
                android:minHeight="48dp"
                android:singleLine="true"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/hint"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/roomTrialResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/text_primary"
                android:textSize="16sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
